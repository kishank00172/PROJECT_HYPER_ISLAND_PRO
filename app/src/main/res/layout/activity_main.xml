<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HYPER ISLAND PRO"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/txtPhase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Phase 3 — Notification Island"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtBuildInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/cardIsland"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Island Engine"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtIslandStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Phase 3 status: OFF"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Real notification listener pipeline. Notifications can expand the island automatically."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIslandToggle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:text="TURN ISLAND ON"
            android:textColor="@color/amoled_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermissionDoctor"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="PERMISSION DOCTOR"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnTestLab"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="TEST LAB"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="SETTINGS"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
