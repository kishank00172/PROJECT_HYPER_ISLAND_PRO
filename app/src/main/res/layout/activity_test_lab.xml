<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Lab"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Phase 3 tests use real Accessibility Overlay and notification island commands."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Reply Morph Animation Lab — V3"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/radioReplyAnimationMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioReplyClassicLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Classic Layout Morph — old width/height resize"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyGpuSmooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. GPU Smooth Scale — current smooth scale"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyMagneticDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. V3 Capsule Chrome — anchored edge"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyLiquidFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. V3 Liquid Parallax — under-layer + sweep"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyElasticBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. V3 HyperOS Snap — fast + settle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyMinimalPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Minimal Pro Fade — fastest clean version"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPreviewReplyFirst"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="PREVIEW: REPLY FIRST ACTION"
            android:textColor="@color/amoled_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreviewReplySecond"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="PREVIEW: REPLY SECOND / RIGHT ACTION"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnExpandIsland"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:text="EXPAND ISLAND"
            android:textColor="@color/amoled_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCollapseIsland"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="COLLAPSE ISLAND"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnToggleIsland"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="TOGGLE EXPAND / COLLAPSE"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnTestNotification"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="TEST NOTIFICATION ISLAND"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_secondary"
            android:text="BACK"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
