<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Lab"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Phase 3 tests use real Accessibility Overlay and notification island commands."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- The morph feel is his to choose, not mine to guess: the style swaps here and the island replays
             it live, so "thoda aur" costs one drag instead of one APK. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Island Morph Lab (content inside the island)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/radioMorphStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/radioMorphBalanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Balanced - content rides the shape, scales, and fades with the shape"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphCarry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ride only - content travels, size fixed, fade on the clock (b1378)"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphScaleOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scale + fade only - content morphs in place, it does not travel"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Glass settle - the text arrives OUT OF FOCUS and sharpens as the box lands; the icon rides in sharp (Apple's glass material, Android RenderEffect)"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphLiquid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Liquid capsule (Claude's design) - the shape runs a real spring and the content is GATED behind it: no text at all until the box is ~60% open. Corners are height/2, growth dodges an off-centre camera, it can overshoot and settle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphHyper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HyperMorph (ChatGPT's design) - five phases: the box first SQUEEZES (97% wide, 106% tall), blooms, carries its content across, micro-settles, and comes back in stages with the content MAGNETICALLY pulled into the pill. Plus a ripple on the surface as it opens"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/tvMorphScaleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="content starts: 12%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMorphScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="45" />

        <TextView
            android:id="@+id/tvMorphSwapLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="icon becomes the app badge at: 50%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMorphSwap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Where the content comes from"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/radioMorphEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/radioMorphEntryDrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drops out of the pill - it comes down from the pill's edge, never sideways"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioMorphEntryCentred"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Centred in the box (old) - it drifts down as the box grows, and in from one side"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMorphDropLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="extra drop from the pill: 20dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMorphDrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40" />

        <TextView
            android:id="@+id/tvMorphStaggerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="entry staggered by: 35%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMorphStagger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/tvMorphGoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="content gone by: 45%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMorphGone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="65" />

        <CheckBox
            android:id="@+id/chkMorphRoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Count roll (the pill's digits slide the way the number moved - Apple's numericText)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReplayMorph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="REPLAY MORPH (open then close)"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnCompareMotion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:text="COMPARE A to B - Claude's capsule, then ChatGPT's hypermorph, both in one tap"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="The two outside designs run on springs, so they need two things the old four styles never asked for: a feel preset, and the numbers that make their phases visible. These sliders do nothing at all to Balanced / Ride / Scale+fade / Glass."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/radioMotionProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/radioProfileSnappy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Snappy - reaches the target and stops, Xiaomi's &quot;it is already open&quot; feel"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioProfileSilky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Silky - Apple's default-ish curve: one small settle, no bounce you can point at"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioProfileBouncy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bouncy - the overshoot is the point; the box goes past the card and comes back"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMotionSqueezeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="phase A squeeze: 3%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMotionSqueeze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8" />

        <TextView
            android:id="@+id/tvMotionGateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="content held back until the box is: 60%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMotionGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90" />

        <TextView
            android:id="@+id/tvMotionMagnetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="pill pulls the content home by: 60%"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekMotionMagnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="150" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Liquid Textbox Calibration (temporary)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/liquidCalibrationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtLiquidHeightValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekLiquidHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="32" />

            <TextView
                android:id="@+id/txtLiquidRadiusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekLiquidRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="26" />

            <TextView
                android:id="@+id/txtLiquidLeftGapValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekLiquidLeftGap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48" />

            <TextView
                android:id="@+id/txtLiquidEdgeGapValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekLiquidEdgeGap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />

            <Button
                android:id="@+id/btnPreviewLiquidCalibration"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="PREVIEW LIQUID VALUES"
                android:textColor="@color/amoled_black"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Reply Morph Animation Lab — V3"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/radioReplyAnimationMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioReplyClassicLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Classic Layout Morph — old width/height resize"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyGpuSmooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. GPU Smooth Scale — current smooth scale"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyMagneticDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. V3 Capsule Chrome — anchored edge"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyLiquidFill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. V3 Liquid Parallax — under-layer + sweep"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyElasticBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. V3 HyperOS Snap — fast + settle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioReplyMinimalPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Minimal Pro Fade — fastest clean version"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>


                <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Notification shade policy (what opening the shelf does)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/radioShadePolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <RadioButton
                android:id="@+id/radioShadeKeepCounting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep counting - the shelf hides the pill, messages still arrive, nothing is wiped"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioShadeWipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Old behaviour - opening the shelf marks everything read and drops new arrivals"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Pill Icon Rendering Lab (temporary test)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/radioPillIconMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioPillIconAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto validated: manual → loadDrawable → adaptive → generic"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillIconSmallOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual resource — NO validation"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillIconAdaptive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="loadDrawable — NO validation"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillIconLauncher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Legacy notification.icon — NO validation"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillIconGeneric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generic glyph"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/radioPillIconApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioPillAppTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telegram"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillAppWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WhatsApp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillAppInstagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instagram"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioPillAppMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google Messages"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPreviewPillIcon"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="PREVIEW PILL ICON"
            android:textColor="@color/amoled_black"
            android:textStyle="bold"
            android:visibility="gone" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Shade Pull Animation Lab (temporary)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/radioShadePullMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioShadePullSimple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simple fade / scale"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioShadePullMyAbsorb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shade Pull Absorb — my preset"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioShadePullKimi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kimi Vacuum Extraction"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioShadePullDeepSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DeepSeek Magnetic Pull"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioShadePullGptHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPT High Magnetic — recommended"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnPreviewShadePull"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="PREVIEW SHADE PULL"
            android:textColor="@color/amoled_black"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPreviewReplyFirst"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:text="PREVIEW: REPLY FIRST ACTION"
            android:textColor="@color/amoled_black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreviewReplySecond"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="PREVIEW: REPLY SECOND / RIGHT ACTION"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnExpandIsland"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
